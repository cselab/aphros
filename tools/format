#!/bin/sh

# Formats tracked C/C++ sources with a pinned version of clang-format.
# With --check, only reports files that need formatting.

set -eu

cd "$(dirname "$0")/.."

: ${CLANG_FORMAT="uvx --from clang-format==23.1.3 clang-format"}

files () {
  git ls-files -- '*.h' '*.hpp' '*.ipp' '*.cpp' '*.c' \
    ':!:doc/' ':!:src/CubismNoCopy/' ':!:src/overlap/'
}

if [ "${1:-}" = "--check" ] ; then
  files | xargs $CLANG_FORMAT --dry-run --Werror
else
  files | xargs $CLANG_FORMAT -i
fi
